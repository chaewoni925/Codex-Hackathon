{
  "name": "jeomgeom-note",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "concurrently --kill-others --names web,api \"npm:dev:web\" \"npm:dev:api\"",
    "dev:web": "vite --config vite.config.ts",
    "dev:api": "node server/index.js",
    "start": "node server/index.js",
    "vision:check": "node ai/test-vision.mjs",
    "build": "tsc --noEmit && vite build --config vite.config.ts",
    "test": "vitest run --config vite.config.ts"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "openai": "^4.77.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.0",
    "vitest": "^3.2.4",
    "typescript": "~5.9.3",
    "vite": "^7.1.0"
  }
}
